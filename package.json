{
  "name": "agentic-rag-mastra",
  "version": "0.1.0",
  "description": "Agentic RAG over the EU AI Act on Mastra, fully local via Ollama, with a deterministic eval gate.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "mastra dev",
    "fetch-corpus": "bun scripts/fetch-corpus.ts && bun scripts/build-chunks.ts",
    "ingest": "bun scripts/ingest.ts",
    "ask": "bun scripts/ask.ts",
    "eval": "bun scripts/eval.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test"
  },
  "dependencies": {
    "@mastra/core": "^1.82.0",
    "@mastra/evals": "^1.10.11",
    "@mastra/langfuse": "^1.6.5",
    "@mastra/libsql": "^1.29.0",
    "@mastra/loggers": "^1.3.10",
    "@mastra/observability": "^1.23.1",
    "@mastra/rag": "^2.7.2",
    "ollama-ai-provider-v2": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "mastra": "^1.38.0",
    "typescript": "^7.0.2"
  }
}
